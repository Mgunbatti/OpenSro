# nmake build for the static libraries and tests. Run toolchain\env.cmd first.
#
#   nmake            build all libraries and tests
#   nmake test       build and run the tests
#   nmake clean

# _SECURE_SCL_THROWS=1: the originals' checked iterators throw out_of_range / invalid_argument
# ("invalid vector<T> subscript") instead of calling _invalid_parameter.
CFLAGS  = /nologo /c /O2 /MT /EHsc /GS /W3 /Zi /DWIN32 /DNDEBUG /D_WINDOWS \
          /D_WIN32_WINNT=0x0500 /DWIN32_LEAN_AND_MEAN /D_SECURE_SCL_THROWS=1 \
          /IJMX_Library /IJMX_ServerFramework /IJMX_CommonServers
LIBFLAGS = /nologo
SYSLIBS = ws2_32.lib user32.lib ole32.lib iphlpapi.lib gdi32.lib comctl32.lib advapi32.lib \
          odbc32.lib

# The vSRO security tables are built in. nmake SECURITY_CONSTANTS=1 uses a table generated by
# tools\gen_security_constants.py instead.
!IFDEF SECURITY_CONSTANTS
CFLAGS = $(CFLAGS) /DBSNET_SECURITY_CONSTANTS
!ENDIF

# The publisher key of the GatewayServer certification queries, generated by
# tools\gen_certify_constants.py (not in the repository); without it the key is empty.
!IF EXIST(JMX_CommonServers\GatewayServer\CertifyConstants.inl)
CFLAGS = $(CFLAGS) /DGATEWAY_CERTIFY_CONSTANTS
!ENDIF

OUT = build
OBJ = $(OUT)\obj
LIBDIR = $(OUT)\lib
BIN = $(OUT)\bin

BSLIB_OBJS = \
	$(OBJ)\BSLib\BSDebug.obj \
	$(OBJ)\BSLib\SynchObject.obj \
	$(OBJ)\BSLib\SimpleThread.obj \
	$(OBJ)\BSLib\ThreadManager.obj \
	$(OBJ)\BSLib\Task.obj \
	$(OBJ)\BSLib\System.obj \
	$(OBJ)\BSLib\ServiceObject.obj \
	$(OBJ)\BSLib\IFile.obj \
	$(OBJ)\BSLib\FileMem.obj \
	$(OBJ)\BSLib\FileLegacy.obj \
	$(OBJ)\BSLib\FileMM.obj \
	$(OBJ)\BSLib\FileSystem.obj \
	$(OBJ)\BSLib\TimeSpan.obj \
	$(OBJ)\BSLib\DateTimeUtil.obj \
	$(OBJ)\BSLib\Database.obj \
	$(OBJ)\BSLib\DBQuery.obj

BSNET_OBJS = \
	$(OBJ)\BSNet\Msg.obj \
	$(OBJ)\BSNet\MsgPool.obj \
	$(OBJ)\BSNet\NetEngineLog.obj \
	$(OBJ)\BSNet\BlowFish.obj \
	$(OBJ)\BSNet\MD5.obj \
	$(OBJ)\BSNet\KeyExchange.obj \
	$(OBJ)\BSNet\Security.obj \
	$(OBJ)\BSNet\SecurityConstants.obj \
	$(OBJ)\BSNet\Proactor.obj \
	$(OBJ)\BSNet\PeerProcess.obj \
	$(OBJ)\BSNet\Maintainer.obj \
	$(OBJ)\BSNet\NetEngineGlobals.obj \
	$(OBJ)\BSNet\BaseSocket.obj \
	$(OBJ)\BSNet\SockStream.obj \
	$(OBJ)\BSNet\SockListener.obj \
	$(OBJ)\BSNet\SockDatagram.obj \
	$(OBJ)\BSNet\SockPool.obj \
	$(OBJ)\BSNet\SockSystem.obj \
	$(OBJ)\BSNet\UdpPing.obj \
	$(OBJ)\BSNet\Session.obj \
	$(OBJ)\BSNet\SessionTable.obj \
	$(OBJ)\BSNet\FileTransfer.obj \
	$(OBJ)\BSNet\KeepAlive.obj \
	$(OBJ)\BSNet\NetEngine.obj

SRVFW_OBJS = \
	$(OBJ)\ServerFramework\MassiveMsg.obj \
	$(OBJ)\ServerFramework\WindowBase.obj \
	$(OBJ)\ServerFramework\GdiUtil.obj \
	$(OBJ)\ServerFramework\Win32SizeRuler.obj \
	$(OBJ)\ServerFramework\Win32Dialog.obj \
	$(OBJ)\ServerFramework\Win32PopupMenu.obj \
	$(OBJ)\ServerFramework\ServerArchitectureView.obj \
	$(OBJ)\ServerFramework\ServerMoniterView.obj \
	$(OBJ)\ServerFramework\ServerFrameWindow.obj \
	$(OBJ)\ServerFramework\ServerBody.obj \
	$(OBJ)\ServerFramework\CertArch.obj \
	$(OBJ)\ServerFramework\CertData.obj \
	$(OBJ)\ServerFramework\ModuleVersion.obj \
	$(OBJ)\ServerFramework\ServerConfig.obj \
	$(OBJ)\ServerFramework\MonitorGraph.obj \
	$(OBJ)\ServerFramework\FileTransMgr.obj \
	$(OBJ)\ServerFramework\ServerFramework.obj \
	$(OBJ)\ServerFramework\LogQueue.obj \
	$(OBJ)\ServerFramework\OverlapJob.obj \
	$(OBJ)\ServerFramework\ServerProcess.obj \
	$(OBJ)\ServerFramework\ServerProcessMain.obj \
	$(OBJ)\ServerFramework\ServerApp.obj \
	$(OBJ)\ServerFramework\CrashDump.obj \
	$(OBJ)\ServerFramework\NTService.obj

LIBS = $(LIBDIR)\ServerFramework.lib $(LIBDIR)\BSNet.lib $(LIBDIR)\BSLib.lib

# GatewayServer application (JMX_CommonServers\GatewayServer). GatewayServer.exe also needs the
# certification part (GATEWAY_CERT_OBJS) and the BSLib database layer; it is built by
# "nmake gateway", not by "all".
GATEWAY_OBJS = \
	$(OBJ)\GatewayServer\GatewayServer.obj \
	$(OBJ)\GatewayServer\GatewayMainProcess.obj \
	$(OBJ)\GatewayServer\ShardConditionManager.obj \
	$(OBJ)\GatewayServer\ArticleManager.obj
GATEWAY_CERT_OBJS = \
	$(OBJ)\GatewayServer\UserCertifier.obj \
	$(OBJ)\GatewayServer\CertifyDB.obj \
	$(OBJ)\GatewayServer\IBUVProcess.obj \
	$(OBJ)\GatewayServer\PrivilegedIPManager.obj \
	$(OBJ)\GatewayServer\GatewayMainProcessCert.obj
GATEWAY_SYSLIBS = kernel32.lib wininet.lib advapi32.lib iphlpapi.lib user32.lib odbc32.lib \
                  ws2_32.lib shlwapi.lib ole32.lib gdi32.lib comctl32.lib
TESTS = $(BIN)\MsgTest.exe $(BIN)\SynchTest.exe $(BIN)\DebugTest.exe $(BIN)\PoolTest.exe \
        $(BIN)\QueTest.exe $(BIN)\MassiveMsgTest.exe $(BIN)\SecurityTest.exe \
        $(BIN)\ThreadTest.exe $(BIN)\FileTest.exe $(BIN)\ProactorTest.exe \
        $(BIN)\SocketTest.exe $(BIN)\NetEngineTest.exe \
        $(BIN)\ServerDataTest.exe $(BIN)\ServerUtilTest.exe \
        $(BIN)\ServerUiTest.exe $(BIN)\ServerAppTest.exe \
        $(BIN)\DatabaseTest.exe $(BIN)\GatewayTest.exe $(BIN)\GatewayCertTest.exe

all: $(LIBS) $(TESTS)

$(OBJ)\BSLib $(OBJ)\BSNet $(OBJ)\ServerFramework $(OBJ)\GatewayServer $(OBJ)\test $(LIBDIR) $(BIN):
	@if not exist $@ mkdir $@

{JMX_Library\BSLib}.cpp{$(OBJ)\BSLib}.obj:
	cl $(CFLAGS) /Fo$@ /Fd$(OBJ)\BSLib\ $<

{JMX_Library\BSLib\thread}.cpp{$(OBJ)\BSLib}.obj:
	cl $(CFLAGS) /Fo$@ /Fd$(OBJ)\BSLib\ $<

{JMX_Library\BSLib\file}.cpp{$(OBJ)\BSLib}.obj:
	cl $(CFLAGS) /Fo$@ /Fd$(OBJ)\BSLib\ $<

{JMX_Library\BSLib\Util}.cpp{$(OBJ)\BSLib}.obj:
	cl $(CFLAGS) /Fo$@ /Fd$(OBJ)\BSLib\ $<

{JMX_Library\BSLib\DB}.cpp{$(OBJ)\BSLib}.obj:
	cl $(CFLAGS) /Fo$@ /Fd$(OBJ)\BSLib\ $<

{JMX_Library\BSNet}.cpp{$(OBJ)\BSNet}.obj:
	cl $(CFLAGS) /Fo$@ /Fd$(OBJ)\BSNet\ $<

{JMX_Library\BSNet\security}.cpp{$(OBJ)\BSNet}.obj:
	cl $(CFLAGS) /Fo$@ /Fd$(OBJ)\BSNet\ $<

{JMX_ServerFramework\ServerFramework}.cpp{$(OBJ)\ServerFramework}.obj:
	cl $(CFLAGS) /Fo$@ /Fd$(OBJ)\ServerFramework\ $<

{JMX_CommonServers\GatewayServer}.cpp{$(OBJ)\GatewayServer}.obj:
	cl $(CFLAGS) /Fo$@ /Fd$(OBJ)\GatewayServer\ $<

{test}.cpp{$(OBJ)\test}.obj:
	cl $(CFLAGS) /Fo$@ /Fd$(OBJ)\test\ $<

$(LIBDIR)\BSLib.lib: $(OBJ)\BSLib $(LIBDIR) $(BSLIB_OBJS)
	lib $(LIBFLAGS) /out:$@ $(BSLIB_OBJS)

$(LIBDIR)\BSNet.lib: $(OBJ)\BSNet $(LIBDIR) $(BSNET_OBJS)
	lib $(LIBFLAGS) /out:$@ $(BSNET_OBJS)

$(LIBDIR)\ServerFramework.lib: $(OBJ)\ServerFramework $(LIBDIR) $(SRVFW_OBJS)
	lib $(LIBFLAGS) /out:$@ $(SRVFW_OBJS)

{$(OBJ)\test}.obj{$(BIN)}.exe:
	link /nologo /DEBUG /out:$@ $< $(LIBS) $(SYSLIBS)

$(TESTS): $(OBJ)\test $(BIN) $(LIBS)

$(BIN)\MsgTest.exe: $(OBJ)\test\MsgTest.obj
$(BIN)\SynchTest.exe: $(OBJ)\test\SynchTest.obj
$(BIN)\DebugTest.exe: $(OBJ)\test\DebugTest.obj
$(BIN)\PoolTest.exe: $(OBJ)\test\PoolTest.obj
$(BIN)\QueTest.exe: $(OBJ)\test\QueTest.obj
$(BIN)\MassiveMsgTest.exe: $(OBJ)\test\MassiveMsgTest.obj
$(BIN)\SecurityTest.exe: $(OBJ)\test\SecurityTest.obj
$(BIN)\ThreadTest.exe: $(OBJ)\test\ThreadTest.obj
$(BIN)\FileTest.exe: $(OBJ)\test\FileTest.obj
$(BIN)\ProactorTest.exe: $(OBJ)\test\ProactorTest.obj
$(BIN)\SocketTest.exe: $(OBJ)\test\SocketTest.obj
$(BIN)\NetEngineTest.exe: $(OBJ)\test\NetEngineTest.obj
$(BIN)\ServerDataTest.exe: $(OBJ)\test\ServerDataTest.obj
$(BIN)\ServerUtilTest.exe: $(OBJ)\test\ServerUtilTest.obj
$(BIN)\ServerUiTest.exe: $(OBJ)\test\ServerUiTest.obj
$(BIN)\ServerAppTest.exe: $(OBJ)\test\ServerAppTest.obj
$(BIN)\DatabaseTest.exe: $(OBJ)\test\DatabaseTest.obj

# The test provides the certification part and the database layer itself.
$(BIN)\GatewayTest.exe: $(OBJ)\GatewayServer $(OBJ)\test\GatewayTest.obj $(GATEWAY_OBJS)
	link /nologo /DEBUG /out:$@ $(OBJ)\test\GatewayTest.obj $(GATEWAY_OBJS) $(LIBS) $(SYSLIBS)

# The certification part with the gateway objects; the test replaces CDBQuery's execution.
$(BIN)\GatewayCertTest.exe: $(OBJ)\GatewayServer $(OBJ)\test\GatewayCertTest.obj $(GATEWAY_OBJS) \
                            $(GATEWAY_CERT_OBJS)
	link /nologo /DEBUG /out:$@ $(OBJ)\test\GatewayCertTest.obj $(GATEWAY_OBJS) \
	    $(GATEWAY_CERT_OBJS) $(LIBS) $(GATEWAY_SYSLIBS)

gateway: $(BIN)\GatewayServer.exe

$(BIN)\GatewayServer.exe: $(BIN) $(LIBS) $(OBJ)\GatewayServer $(GATEWAY_OBJS) \
                          $(OBJ)\GatewayServer\WinMain.obj $(GATEWAY_CERT_OBJS)
	link /nologo /DEBUG /SUBSYSTEM:WINDOWS /out:$@ $(OBJ)\GatewayServer\WinMain.obj \
	    $(GATEWAY_OBJS) $(GATEWAY_CERT_OBJS) $(LIBS) $(GATEWAY_SYSLIBS)

test: all
	$(BIN)\MsgTest.exe
	$(BIN)\SynchTest.exe
	$(BIN)\DebugTest.exe
	$(BIN)\PoolTest.exe
	$(BIN)\QueTest.exe
	$(BIN)\MassiveMsgTest.exe
	$(BIN)\SecurityTest.exe
	$(BIN)\ThreadTest.exe
	$(BIN)\FileTest.exe
	$(BIN)\ProactorTest.exe
	$(BIN)\SocketTest.exe
	$(BIN)\NetEngineTest.exe
	$(BIN)\ServerDataTest.exe
	$(BIN)\ServerUtilTest.exe
	$(BIN)\ServerUiTest.exe
	$(BIN)\ServerAppTest.exe
	$(BIN)\DatabaseTest.exe
	$(BIN)\GatewayTest.exe
	$(BIN)\GatewayCertTest.exe

clean:
	@if exist $(OUT) rmdir /s /q $(OUT)
